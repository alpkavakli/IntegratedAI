{
  "name": "integratedai",
  "version": "0.3.0",
  "license": "AGPL-3.0-or-later",
  "description": "Local agent server for the IntegratedAI Chrome extension: use your Claude or ChatGPT subscription (Claude Code, Codex) from the browser.",
  "keywords": [
    "chrome-extension",
    "devtools",
    "claude-code",
    "codex",
    "mcp",
    "browser-agent"
  ],
  "homepage": "https://github.com/alpkavakli/IntegratedAI#setup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpkavakli/IntegratedAI.git"
  },
  "bugs": {
    "url": "https://github.com/alpkavakli/IntegratedAI/issues"
  },
  "author": "Alp Kavaklı",
  "type": "module",
  "bin": {
    "integratedai": "server/bin/integratedai.js"
  },
  "files": [
    "server/bin/",
    "server/src/",
    "server/native-host/",
    "extension/shared/",
    "scripts/services.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "test": "node --test \"server/test/*.test.js\"",
    "check": "tsc --noEmit -p jsconfig.json",
    "package": "node scripts/package-extension.js",
    "vendor:sdk": "node scripts/vendor-sdk.js",
    "site": "node scripts/build-site.js",
    "ui-check": "node scripts/ui-check.mjs",
    "page-check": "node scripts/page-check.mjs",
    "services:install": "node scripts/services.mjs install",
    "services:uninstall": "node scripts/services.mjs uninstall",
    "quiz-demo": "node scripts/quiz-demo.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
